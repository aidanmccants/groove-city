{
  // Wrangler config for the multiplayer campus map. See README.md.
  "name": "groove-city-college",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // public/ (built by build.mjs) holds the page and maps/*.js map data, served as static assets
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // runs before every `wrangler dev` and `wrangler deploy` (also in Cloudflare's Git builds, which skip npm scripts);
  // dev rebuilds when the game code or page shell changes
  "build": { "command": "node build.mjs", "watch_dir": ["../client", "../shared", "../src"] },
  // one Durable Object instance ("campus") holds every connected visitor
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "MapRoom" }]
  },
  // accounts, sessions and (later) property; the Worker creates its tables on first use (src/schema.js)
  "d1_databases": [{ "binding": "DB", "database_name": "groove-city", "database_id": "7ddee53a-fc73-4ead-ae74-5ee168c9ac8e" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MapRoom"] }],
  "observability": { "enabled": true }
}
