{
  // Wrangler config for the multiplayer campus map. See README.md.
  "name": "groove-city-college",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // public/ (built by build.mjs) holds the page and maps/*.js map data, served as static assets
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // one Durable Object instance ("campus") holds every connected visitor
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "MapRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MapRoom"] }],
  "observability": { "enabled": true }
}
